# @react-three/fiber's peer range (react >=19 <19.3) lags the latest React
# 19.x patch releases. This is a peer-range staleness issue, not a real
# incompatibility — legacy-peer-deps skips the strict check rather than
# forcing a version. Lives at the repo root, not Frontend/, because npm
# workspaces ignore a per-workspace .npmrc; this is also what Vercel's
# `maison-abeer-web` build picks up, since its plain `npm install` fails
# with ERESOLVE otherwise.
legacy-peer-deps=true
