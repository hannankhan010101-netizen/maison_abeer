# @react-three/fiber's peer range (react >=19 <19.3) lags the latest React
# 19.x patch releases. This is a peer-range staleness issue, not a real
# incompatibility — legacy-peer-deps skips the strict check rather than
# forcing a version.
#
# This file has to exist in BOTH Frontend/ and the repo root:
#   - Vercel's `maison-abeer-web` build deploys via the CLI from inside
#     Frontend/ with no git integration, so it only ever uploads this
#     directory — the repo-root .npmrc is invisible to it, and Frontend's
#     package.json has no "workspaces" field of its own, so npm treats the
#     install there as a standalone project and reads this file normally.
#   - A local `npm install` run from within the real monorepo walks up and
#     finds the root workspace instead, and npm workspaces ignore a
#     per-workspace .npmrc — hence the twin file at the repo root.
legacy-peer-deps=true
