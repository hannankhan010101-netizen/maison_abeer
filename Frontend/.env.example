# Public — safe to ship to the browser. The publishable (anon) key is
# rate-limited and RLS-constrained by design. The `sb_secret_…` key is not,
# and must never appear in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# The FastAPI gateway. All application data flows through here, including the
# public booking page, so this must be reachable from a guest's browser —
# not an internal hostname.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo mode: answers from fixtures and skips sign-in, so the app is usable
# without a backend. Development only — a production build folds this to
# false and drops the branch. Do not set it on Vercel.
NEXT_PUBLIC_DEMO_MODE=0
