# Vercel uploads this directory verbatim — it does not read .gitignore — and
# then runs its own install. Without this, `node_modules` and the local build
# output ship too: the first deploy uploaded 251.6MB for that reason.
node_modules/
.next/
.next-e2e/

# Playwright output, already gitignored.
test-results/
playwright-report/
blob-report/
playwright/.cache/

.env
.env.*
!.env.example
