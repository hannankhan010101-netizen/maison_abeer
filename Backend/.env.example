# ---------------------------------------------------------------------------
# Supabase — from Project Settings → API and Database
# ---------------------------------------------------------------------------
# Used to build the JWKS URL for verifying incoming access tokens.
SUPABASE_URL=https://your-project-ref.supabase.co

# SERVER-SIDE ONLY. Never expose this to the browser, and never put it in a
# NEXT_PUBLIC_ variable. Newer projects issue `sb_secret_…` in place of the
# older service_role JWT; either works here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Connection string. Which pooler you want depends on where this runs:
#
#   Long-lived host (uvicorn on a VM)  → session pooler,     port 5432
#   Serverless (Vercel)                → transaction pooler, port 6543
#
# The direct `db.<ref>.supabase.co` host is IPv6-only on newer projects and
# will not resolve from an IPv4-only network. Percent-encode any reserved
# character in the password — a bare `#` starts the URI fragment and silently
# truncates it.
DATABASE_URL=postgresql+psycopg://postgres.your-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# `production` disables /docs and /openapi.json — the schema is free
# reconnaissance for an attacker.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated, no JSON. Must list every origin the browser calls from,
# including the Vercel preview domain if you use one.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# Serverless deployment (Vercel)
# ---------------------------------------------------------------------------
# Switches to NullPool and disables prepared statements. Required with the
# transaction pooler; leaving it false there exhausts the connection limit and
# raises `prepared statement "_pg3_0" does not exist` under load.
DB_SERVERLESS=false

# Shared secret for the scheduled-task endpoint. On Vercel, set this to the
# same value as the project's CRON_SECRET. Empty disables the endpoint
# entirely rather than leaving it open.
CRON_SECRET=
