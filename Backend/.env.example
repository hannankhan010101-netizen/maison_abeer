# ---------------------------------------------------------------------------
# Supabase — from Project Settings → API and Database
# ---------------------------------------------------------------------------
# Used to build the JWKS URL for verifying incoming access tokens.
SUPABASE_URL=https://your-project-ref.supabase.co

# SERVER-SIDE ONLY. Never expose this to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pooled connection string (Settings → Database → Connection pooling, mode: session).
DATABASE_URL=postgresql+psycopg://postgres.your-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
